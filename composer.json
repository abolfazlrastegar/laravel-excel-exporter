{
    "name": "abolfazrastegar/laravel-excel-exporter",
    "description": "A powerful and flexible Excel/CSV exporter for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Abolfazl Rastegar",
            "email": "abolfazlrastegar1996@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "phpoffice/phpspreadsheet": "^5.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "maennchen/zipstream-php": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Abolfazrastegar\\LaravelExcelExporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Abolfazrastegar\\LaravelExcelExporter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abolfazrastegar\\LaravelExcelExporter\\ExcelServiceProvider"
            ],
            "aliases": {
                "ARExcel": "Abolfazrastegar\\LaravelExcelExporter\\Facades\\ARExcel"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-text",
        "validate": "composer validate --strict"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}